# Database Configuration
# Railway automatically provides MYSQL_* variables
# For local development, use these settings:

# MySQL Connection (Local Development)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=logindb

# Alternative variable names (also supported)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=logindb

# Admin Password (for production - CHANGE THIS!)
ADMIN_PASSWORD=admin1234

# Session Secret (change this in production - use a strong random string)
SESSION_SECRET=your-secret-key-change-this-in-production

# Node Environment
NODE_ENV=development